version: 4
data:
  graphs:
    main:
      metadata:
        id: main
        name: Race Inputs
      nodes:
        '[n1]:graphInput "First"':
          data:
            id: first
            dataType: string
            defaultValue: winner
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Race" n3/input1
        '[n2]:graphInput "Second"':
          data:
            id: second
            dataType: string
            defaultValue: loser
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Race" n3/input2
        '[n3]:raceInputs "Race"':
          outgoingConnections:
            - result->"Graph Output" n4/value
        '[n4]:graphOutput "Graph Output"':
          data:
            id: out
            dataType: string
      connections: {}
