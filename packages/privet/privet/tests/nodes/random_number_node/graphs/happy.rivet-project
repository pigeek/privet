version: 4
data:
  graphs:
    main:
      metadata:
        id: main
        name: RNG
      nodes:
        '[n1]:randomNumber "RNG"':
          data:
            min: 1
            max: 3
            integers: true
            maxInclusive: true
            useMinInput: false
            useMaxInput: false
          outgoingConnections:
            - value->"Graph Output" n2/value
        '[n2]:graphOutput "Graph Output"':
          data:
            id: out
            dataType: number
      connections: {}
