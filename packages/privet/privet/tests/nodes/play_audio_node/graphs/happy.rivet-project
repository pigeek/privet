version: 4
data:
  graphs:
    main:
      metadata:
        id: main
        name: Play Audio
      nodes:
        '[n1]:graphInput "Audio"':
          data:
            id: aud
            dataType: audio
            defaultValue:
              data: beep
              mediaType: audio/wav
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Play" n2/data
        '[n2]:playAudio "Play"':
          outgoingConnections:
            - data->"Graph Output" n3/value
        '[n3]:graphOutput "Graph Output"':
          data:
            id: out
            dataType: audio
      connections: {}
